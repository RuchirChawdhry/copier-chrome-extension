{% if include_example %}{% raw %}<script lang="ts">
  import Surface from '../components/Surface.svelte';
  import { onMount } from 'svelte';
  import features from '../../../extension.config.json';
  import { createLogger, errorMessage } from '../../core/logger';
  import { watchStorage } from '../../core/reactive-storage';
  import { send } from '../../example/messages';
  import { exampleStorage } from '../../example/storage';
  import Button from '../components/Button.svelte';
  import Card from '../components/Card.svelte';
  import StatePanel from '../components/StatePanel.svelte';

  const logger = createLogger('popup');
  const items = $derived.by(() => {
    // Recreate the readable subscription on explicit retry.
    return makeItems(attempt);
  });
  function makeItems(_attempt: number) {
    return watchStorage(
      exampleStorage.defaultValue('example.links'),
      (update, fail) => exampleStorage.observe('example.links', update, fail),
    );
  }
  let attempt = $state(0);
  let tabReady = $state(false);
  let tab = $state<chrome.tabs.Tab | null>(null);
  let windowId = $state<number | null>(null);
  let busy = $state(false);
  let error = $state('');

  const title = chrome.runtime.getManifest().name;

  function loadTab() {
    tabReady = false;
    error = '';
    void chrome.tabs
      .query({ active: true, currentWindow: true })
      .then((tabs) => {
        tab = tabs[0] ?? null;
        windowId = tab?.windowId ?? null;
        tabReady = true;
      })
      .catch((cause: unknown) => {
        logger.warn('Active tab lookup failed');
        error = errorMessage(cause);
      });
  }
  onMount(loadTab);

  async function saveCurrent() {
    if (!tab?.url) return;
    busy = true;
    error = '';
    try {
      await send('items.add', { url: tab.url, title: tab.title });
    } catch (cause) {
      logger.warn('Save failed');
      error = errorMessage(cause);
    } finally {
      busy = false;
    }
  }

  function openSidebar() {
    if (windowId !== null) {
      // Call directly inside the user gesture; no service-worker round-trip.
      void chrome.sidePanel.open({ windowId }).catch((cause: unknown) => {
        error = cause instanceof Error ? cause.message : String(cause);
      });
    }
  }
</script>

<Surface {title} label="Quick actions" description="Save and revisit your links." ready={$items.ready && tabReady} badge={($items.ready ? $items.value.length : '—') + ' saved'}>
  <div class="grid grid-cols-2 gap-2">
    <Button
      primary
      class="col-span-2"
      {busy}
      onclick={saveCurrent}
      disabled={!tabReady || !tab?.url || !/^https?:/.test(tab.url)}
    >
      {busy ? 'Saving…' : 'Save current page'}
    </Button>
    {#if features.sidebar}
      <Button onclick={openSidebar} disabled={windowId === null}>
        Open sidebar
      </Button>
    {/if}
    {#if features.settings}
      <Button
        onclick={() => {
          void chrome.runtime
            .openOptionsPage()
            .catch(() => logger.error('Unable to open settings'));
        }}
      >
        Settings
      </Button>
    {/if}
  </div>
  {#if error}
    <StatePanel
      kind="error"
      message={error}
      retry={!tabReady ? loadTab : undefined}
    />
  {/if}
  {#if !tabReady && !error}
    <StatePanel kind="loading" message="Checking active tab…" />
  {/if}
  {#if $items.error}
    <StatePanel
      kind="error"
      message={$items.error}
      retry={() => {
        attempt += 1;
      }}
    />
  {:else if !$items.ready}
    <StatePanel kind="loading" message="Loading saved links…" />
  {:else if $items.value.length}
    <Card title="Recently saved">
      <ul class="divide-y divide-border">
        {#each $items.value.slice(0, 3) as item (item.id)}
          <li class="flex items-center gap-3 py-3 first:pt-0 last:pb-0">
            <a
              class="block truncate text-sm font-medium text-foreground hover:text-primary"
              href={item.url}
              target="_blank"
              rel="noreferrer"
              title={item.url}
              >{item.title}</a
            >
          </li>
        {/each}
      </ul>
    </Card>
  {:else}
    <StatePanel kind="empty" message="No saved links yet." />
  {/if}
</Surface>
{% endraw %}{% else %}{% raw %}<script lang="ts">
  import Surface from '../components/Surface.svelte';
  import { onMount } from 'svelte';
  import config from '../../../extension.config.json';
  import { createLogger, errorMessage } from '../../core/logger';
  import Button from '../components/Button.svelte';
  import Status from '../components/Status.svelte';

  const title = chrome.runtime.getManifest().name;
  const logger = createLogger('popup');
  let error = $state('');
  let windowId = $state<number | undefined>(undefined);
  onMount(() => {
    if (config.sidebar)
      void chrome.windows
        .getCurrent()
        .then((window) => {
          windowId = window.id;
        })
        .catch(() => logger.warn('Unable to identify window'));
  });
  function fail(cause: unknown) {
    error = errorMessage(cause);
    logger.warn('Unable to open interface');
  }
  function openSidebar() {
    if (windowId !== undefined)
      void chrome.sidePanel.open({ windowId }).catch(fail);
  }
  function openSettings() {
    void chrome.runtime.openOptionsPage().catch(fail);
  }
</script>

<Surface {title} label="Quick actions" description="Open your extension workspace.">
  {#if config.sidebar || config.settings}
    <div class="flex flex-wrap gap-2">
      {#if config.sidebar}
        <Button onclick={openSidebar} disabled={windowId === undefined}
          >Open sidebar</Button
        >
      {/if}
      {#if config.settings}
        <Button onclick={openSettings}>Settings</Button>
      {/if}
    </div>
  {/if}
  <Status message={error} kind="error" />
</Surface>
{% endraw %}{% endif %}