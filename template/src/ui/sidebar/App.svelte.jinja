{% if include_example %}{% raw %}<script lang="ts">
  import { createLogger, errorMessage } from '../../core/logger';
  import { watchStorage } from '../../core/reactive-storage';
  import { send } from '../../example/messages';
  import { exampleStorage } from '../../example/storage';
  import Button from '../components/Button.svelte';
  import SearchField from '../components/SearchField.svelte';
  import StatePanel from '../components/StatePanel.svelte';
  import Surface from '../components/Surface.svelte';
  import Toggle from '../components/Toggle.svelte';

  const logger = createLogger('sidebar');
  let attempt = $state(0);
  let query = $state('');
  let showUrls = $state(true);
  let removing = $state<string | null>(null);
  const items = $derived.by(() => makeItems(attempt));
  function makeItems(_attempt: number) {
    return watchStorage(
      exampleStorage.defaultValue('example.links'),
      (update, fail) => exampleStorage.observe('example.links', update, fail),
    );
  }
  const filtered = $derived(
    $items.value.filter((item) =>
      (item.title + ' ' + item.url)
        .toLowerCase()
        .includes(query.toLowerCase().trim()),
    ),
  );
  let error = $state('');

  const title = chrome.runtime.getManifest().name;

  async function remove(id: string) {
    error = '';
    removing = id;
    try {
      await send('items.remove', { id });
    } catch (cause) {
      logger.warn('Remove failed');
      error = errorMessage(cause);
    } finally {
      removing = null;
    }
  }
</script>

<Surface
  {title}
  label="Workspace"
  description="Find and manage saved links."
  ready={$items.ready}
  badge={String($items.ready ? $items.value.length : '—')}
>
  {#if error}
    <StatePanel kind="error" message={error} />
  {/if}
  {#if $items.error}
    <StatePanel
      kind="error"
      message={$items.error}
      retry={() => {
        attempt += 1;
      }}
    />
  {:else if !$items.ready}
    <StatePanel kind="loading" message="Loading saved items…" />
  {:else if !$items.value.length}
    <StatePanel
      kind="empty"
      message="Nothing saved yet. Save a page to get started."
    />
  {:else}
    <SearchField bind:value={query} label="Search saved links" />
    <Toggle bind:checked={showUrls} label="Show link addresses" />
    {#if !filtered.length}
      <StatePanel kind="empty" message="No matching links." />
    {/if}
    <ul
      class="divide-y divide-border rounded-lg border border-border bg-card p-3"
    >
      {#each filtered as item (item.id)}
        <li class="flex items-center gap-3 py-3 first:pt-0 last:pb-0">
          <div class="min-w-0 flex-1">
            <a
              class="block truncate text-sm font-medium text-foreground hover:text-primary"
              href={item.url}
              target="_blank"
              rel="noreferrer"
              title={item.url}
              >{item.title}</a
            >
            {#if showUrls}
              <span class="block truncate text-xs text-muted-foreground"
                >{item.url}</span
              >
            {/if}
          </div>
          <Button
            class="shrink-0 text-xs"
            busy={removing === item.id}
            disabled={removing !== null}
            aria-label={'Remove ' + item.title}
            onclick={() => remove(item.id)}
          >
            Remove
          </Button>
        </li>
      {/each}
    </ul>
  {/if}
</Surface>
{% endraw %}{% else %}{% raw %}<script lang="ts">
  import Surface from '../components/Surface.svelte';

  const title = chrome.runtime.getManifest().name;
</script>

<Surface {title} label="Workspace" description="Your extension sidebar.">
  <div
    class="rounded-lg border border-dashed border-border p-4 text-sm text-muted-foreground"
  >
    Ready for your product interface.
  </div>
</Surface>
{% endraw %}{% endif %}