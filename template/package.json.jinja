{
  "name": {{ project_slug | tojson }},
  "extensionName": {{ project_name | tojson }},
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": {{ project_description | tojson }},
  "engines": { "node": ">=22.12.0" },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "bench": "pnpm build && node scripts/bench.mjs",
    "package": "pnpm build && node scripts/package.mjs"
  },
  "dependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/chrome": "^0.0.300",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
