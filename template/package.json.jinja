{
  "name": {{ project_slug | tojson }},
  "extensionName": {{ project_name | tojson }},
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": {{ project_description | tojson }},
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm hooks:install && pnpm exec playwright install chromium",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "dev": "node scripts/dev.mjs",
    "postinstall": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "fix": "biome check --write .",
    "build": "node scripts/build.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "screenshots": "pnpm build && playwright test screenshots.spec.ts",
    "test:reload": "node scripts/test-reload.mjs",
    "bench": "pnpm build && node scripts/bench.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "report:size": "pnpm build && node scripts/report-size.mjs",
    "package": "pnpm build && pnpm verify:build && node scripts/package.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  },
  "lint-staged": {
    "*.{ts,js,mjs,svelte,css,json,html}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "lefthook": "^1.13.0",
    "lint-staged": "^16.1.0",
    "ws": "^8.18.0",
    "fflate": "^0.8.2",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
